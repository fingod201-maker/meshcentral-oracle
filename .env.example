# Copy this file to .env and fill in your values.
# The deploy scripts read .env automatically. Never commit .env.

# Public hostname for MeshCentral. It must have an A record (and AAAA if IPv6)
# pointing at the Oracle VM's public IP.
DOMAIN=mesh.example.com

# Email used for the Let's Encrypt registration and certificate notices.
LE_EMAIL=admin@example.com

# Browser title.
SITE_TITLE="My Mesh"

# Oracle VM SSH connection.
VM_HOST=203.0.113.10
VM_USER=opc
# Windows example: C:\Users\you\.ssh\oracle.key
SSH_KEY=
SSH_PORT=22

# Runtime. The guide pins Node 20. Node 20 is EOL as of April 2026; use 22 if
# you want a supported runtime. MeshCentral 1.3.x requires Node >= 20.
NODE_MAJOR=20

# Keep false for the first deployment so Let's Encrypt uses its staging service.
# Set true only after the staging certificate works, or use -Action promote.
LE_PRODUCTION=false

# Optional: where the bundle is copied on the VM.
# Defaults to /home/<VM_USER>/meshcentral-oracle (or /root/... for root).
# REMOTE_DIR=/home/ubuntu/meshcentral-oracle
